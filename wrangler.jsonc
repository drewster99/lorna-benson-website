{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lorna-benson-website",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "lornabenson.com", "custom_domain": true },
    { "pattern": "www.lornabenson.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
